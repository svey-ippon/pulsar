# Runtime secrets for the full Pulsar stack.
# Copy to .env and fill in values — never commit .env.
#
# CUBE_API_URL is set automatically by docker-compose (http://cube:4000/...).
# For local development without Docker, set it here:
# CUBE_API_URL=http://localhost:4000/cubejs-api/v1

# JWT signed from cube/.env CUBEJS_API_SECRET (not the raw secret).
# Generate with: node -e "require('@cubejs-backend/api-gateway').CubejsServerCore.createJwtToken({ iat: 0 }, process.env.CUBEJS_API_SECRET)"
CUBE_API_TOKEN=

# Anthropic API key for Claude
ANTHROPIC_API_KEY=
